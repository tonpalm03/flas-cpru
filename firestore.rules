rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (getUserData().role == 'admin' || request.auth.token.email == 'tonpalm03@cpru.ac.th');
    }

    function isDean() {
      return isAuthenticated() && (getUserData().role == 'dean' || isAdmin());
    }

    function isFinanceStaff() {
      return isAuthenticated() && (getUserData().role == 'staff_finance' || isAdmin());
    }

    function isProcurementStaff() {
      return isAuthenticated() && (getUserData().role == 'staff_procurement' || isAdmin());
    }

    function isHRStaff() {
      return isAuthenticated() && (getUserData().role == 'staff_hr' || isAdmin());
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 2. Master Templates & System Settings
    match /templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Admin Inbound & Outbound Registry
    match /admin_documents_in/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /admin_documents_out/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 4. Official Memos
    match /memos/{memoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 5. Strategic Projects & Reports
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /project_reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 6. Procurement & Purchase Requisitions
    match /procurement/{prId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 7. Finance Loans, Ledger, Transactions & Disbursement
    match /finance_loans/{loanId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /finance_ledger/{ledgerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /finance_transactions/{txId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /finance_disbursements/{disburseId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 8. HR e-Leaves, Portfolios, Contracts & Quotas
    match /hr_leaves/{leaveId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /hr_portfolios/{portfolioId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /hr_contracts/{contractId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /hr_quotas/{quotaId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 9. Room & Vehicle Bookings
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 10. Orders & Announcements
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 11. Admin Responses & Checklists
    match /admin_responses/{respId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 12. Strategic Plans & KPIs
    match /strategic_plans/{planId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isDean();
    }

    // 13. System Notifications
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // 14. Employees Registry & Account Invitations
    match /hr_employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isHRStaff() || isAdmin();
    }

    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow write: if isHRStaff() || isAdmin();
    }

    // 15. Work Policies, Shifts & Public Holidays
    match /work_policies/{policyId} {
      allow read: if isAuthenticated();
      allow write: if isHRStaff() || isAdmin();
    }

    match /public_holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow write: if isHRStaff() || isAdmin();
    }

    // 16. Attendance Events (Raw logs - Immutable append-only)
    match /attendance_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 17. Attendance Sessions & Corrections
    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /attendance_corrections/{correctionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 18. Monthly Attendance Reports & Period Locks
    match /attendance_monthly_reports/{reportId} {
      allow read: if isAuthenticated();
      allow create, update: if isHRStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    match /attendance_period_locks/{lockId} {
      allow read: if isAuthenticated();
      allow write: if isHRStaff() || isAdmin();
    }

    // 10. Audit Logs (Immutable append-only)
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isDean();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Helper functions for administrative permissions
    function isClerk() {
      return isAuthenticated() && (
        getUserData().role == 'admin' || 
        getUserData().roles.hasAny(['แอดมิน', 'ธุรการ']) ||
        isAdmin()
      );
    }

    // 19. Dynamic Navigation & Layouts
    match /system_navigation/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 20. Admin Document Categories & Registry
    match /admin_doc_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin() || isClerk();
    }

    match /system_workflows/{workflowId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 20.1 สิทธิ์การแก้ไขโมดูลธุรการ (จดหมายข่าว วาระการประชุม ตารางงาน)
    // ทุกคนที่ล็อกอินอ่านได้ ผู้แก้ไขเป็นไปตามยศที่แอดมินกำหนดใน system_module_permissions
    function moduleEditorRoles(moduleKey) {
      return exists(/databases/$(database)/documents/system_module_permissions/$(moduleKey))
        ? get(/databases/$(database)/documents/system_module_permissions/$(moduleKey)).data.editorRoles
        : ['แอดมิน', 'ธุรการ'];
    }

    function canEditModule(moduleKey) {
      return isAuthenticated() && (
        isAdmin() ||
        (isClerk() && ('ธุรการ' in moduleEditorRoles(moduleKey))) ||
        (getUserData().keys().hasAny(['roles']) && getUserData().roles.hasAny(moduleEditorRoles(moduleKey)))
      );
    }

    match /system_module_permissions/{moduleKey} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /admin_newsletters/{itemId} {
      allow read: if isAuthenticated();
      allow write: if canEditModule('newsletter');
    }

    match /admin_meetings/{itemId} {
      allow read: if isAuthenticated();
      allow write: if canEditModule('meetings');
    }

    match /admin_calendar_events/{itemId} {
      allow read: if isAuthenticated();
      allow write: if canEditModule('calendar');
    }

    match /admin_doc_registry/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.createdById == request.auth.uid || 
        request.resource.data.createdById == 'guest' ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.createdById == request.auth.uid ||
        isClerk() ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.createdById == request.auth.uid || 
        isClerk() || 
        isAdmin()
      );
    }

    // 21. Dynamic System Roles
    match /system_roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 22. Visual Portal Blocks & Config
    match /portal_blocks/{blockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portal_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 23. System Configs
    match /system_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 11. Atomic Numbering System Counters
    match /system_counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
