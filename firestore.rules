rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (getUserData().role == 'admin' || request.auth.token.email == 'tonpalm03@cpru.ac.th');
    }

    function isDean() {
      return isAuthenticated() && (getUserData().role == 'dean' || isAdmin());
    }

    function isFinanceStaff() {
      return isAuthenticated() && (getUserData().role == 'staff_finance' || isAdmin());
    }

    function isProcurementStaff() {
      return isAuthenticated() && (getUserData().role == 'staff_procurement' || isAdmin());
    }

    function isHRStaff() {
      return isAuthenticated() && (getUserData().role == 'staff_hr' || isAdmin());
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow registration with default roles, or admin creation
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Users cannot promote themselves or alter status
      allow update: if isAdmin() || (
        request.auth.uid == userId && 
        request.resource.data.role == resource.data.role && 
        request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin();
    }

    // 2. Master Templates & System Settings
    match /templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Admin Inbound & Outbound Registry
    match /admin_documents_in/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /admin_documents_out/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 4. Official Memos
    match /memos/{memoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 5. Strategic Projects
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 6. Procurement & Purchase Requisitions
    match /procurement/{prId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 7. Finance Loans & Disbursement
    match /finance_loans/{loanId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /finance_ledger/{ledgerId} {
      allow read: if isAuthenticated();
      allow create, update: if isFinanceStaff();
      allow delete: if isAdmin();
    }

    // 8. HR e-Leaves & Records
    match /hr_leaves/{leaveId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 9. Room & Vehicle Bookings
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 10. Orders & Announcements
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 11. Admin Responses & Checklists
    match /admin_responses/{respId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /admin_checklists/{checkId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 10. Audit Logs (Immutable append-only)
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isDean();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 11. Atomic Numbering System Counters
    match /system_counters/{counterId} {
      allow read, write: if isAuthenticated();
    }
  }
}
